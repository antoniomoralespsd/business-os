# ---- Modo de datos ----
# firestore = Firebase real (o emuladores). memory = demo local sin Firebase.
NEXT_PUBLIC_DATA_MODE=firestore
NEXT_PUBLIC_WORKSPACE_ID=main

# ---- Firebase SDK cliente (Consola Firebase → Configuración del proyecto → Tus apps → Web). No son secretos. ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true para apuntar a los emuladores locales (firebase emulators:start)
NEXT_PUBLIC_USE_EMULATORS=false

# ---- Servidor ----
# Emails que pueden entrar (separados por comas)
ALLOWED_EMAILS=antoniomorales.psd@gmail.com,tonimc99@gmail.com
# En local: ruta al JSON de una cuenta de servicio (NO subir al repo). En App Hosting no hace falta.
GOOGLE_APPLICATION_CREDENTIALS=
