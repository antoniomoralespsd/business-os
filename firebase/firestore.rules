rules_version = '2';
// Business OS — Firestore security rules.
// Clients only READ (realtime listeners). Every write goes through /api/actions with the Admin SDK,
// which bypasses these rules after validating session, membership and input.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(ws) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /workspaces/{ws} {
      allow read: if isMember(ws);
      allow write: if false;

      match /{collection}/{docId} {
        // Never readable from the browser: counters (invoice numbering) and integration internals.
        allow read: if isMember(ws) && !(collection in ['counters', 'secrets']);
        allow write: if false;
      }
    }
  }
}
